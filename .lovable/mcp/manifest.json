{
  "version": 1,
  "sdk_version": "3.0.5",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://mrtdpxjblfpfapdxdcnu.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "upsystem-fincontrol",
      "version": "1.0.0",
      "title": "UPSYSTEM FINCONTROL"
    },
    "tools": [
      {
        "name": "listar_clientes",
        "title": "Consultar clientes",
        "description": "Consulta clientes e contratos não excluídos da conta conectada, com busca e paginação.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "busca": {
              "description": "Parte do nome ou CPF/CNPJ.",
              "type": "string",
              "maxLength": 100
            },
            "situacao": {
              "type": "string",
              "enum": [
                "ATIVO",
                "INATIVO"
              ]
            },
            "limite": {
              "default": 25,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "pagina": {
              "default": 1,
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "listar_titulos",
        "title": "Consultar títulos financeiros",
        "description": "Consulta títulos não excluídos da conta conectada, filtrando por cliente, situação e mês de referência.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "cliente_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "situacao": {
              "type": "string",
              "enum": [
                "ABERTO",
                "PAGO"
              ]
            },
            "mes_ano": {
              "description": "Mês de referência exatamente como cadastrado no financeiro.",
              "type": "string",
              "maxLength": 20
            },
            "limite": {
              "default": 25,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "pagina": {
              "default": 1,
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "listar_cobrancas_efi",
        "title": "Consultar cobranças Efí",
        "description": "Consulta o histórico e os status salvos de cobranças Efí da conta conectada, sem emitir ou modificar cobranças.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "cliente_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "status": {
              "description": "Status exatamente como salvo no histórico.",
              "type": "string",
              "minLength": 1,
              "maxLength": 50
            },
            "limite": {
              "default": 25,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "pagina": {
              "default": 1,
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
