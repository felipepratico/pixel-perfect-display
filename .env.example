# ─────────────────────────────────────────────────────────────
# Efí Bank (Gerencianet) — API de Cobranças
#
# Configure estes valores como "secrets" no ambiente do servidor
# (no Lovable: Settings → Environment / Secrets).
# NÃO versione credenciais reais: use este arquivo apenas como referência.
# ─────────────────────────────────────────────────────────────

# Par de credenciais da aplicação Efí (app.sejaefi.com.br → API).
# É possível manter um par por ambiente usando os sufixos abaixo.
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
# EFI_CLIENT_ID_HOMOLOGACAO=
# EFI_CLIENT_SECRET_HOMOLOGACAO=
# EFI_CLIENT_ID_PRODUCAO=
# EFI_CLIENT_SECRET_PRODUCAO=

# true  → homologação (https://cobrancas-h.api.efipay.com.br)
# false → produção     (https://cobrancas.api.efipay.com.br)
EFI_SANDBOX=true

# Certificado A1 (mTLS) — opcional para a API de Cobranças.
# O runtime roda em Cloudflare Workers, onde o certificado é um "binding"
# de mTLS e não um arquivo. Para habilitar:
#   npx wrangler mtls-certificate upload --cert cert.pem --key key.pem --name efi-a1
# e declare o binding no wrangler do projeto:
#   [[mtls_certificates]]
#   binding = "EFI_CERTIFICATE"
#   certificate_id = "<CERTIFICATE_ID>"
# Quando o binding existe, as chamadas à Efí apresentam o certificado automaticamente.
